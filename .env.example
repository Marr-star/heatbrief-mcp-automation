# Mock mode works without credentials. Live comparison is gated until verified.
HEATBRIEF_MODE=mock
HEATBRIEF_DATA_DIR=data
# Required for authenticated HTTP access (set a unique local value).
HEATBRIEF_API_TOKEN=replace-with-a-random-local-token
# Do not commit your actual FortyGuard credentials.
FORTYGUARD_MCP_URL=
FORTYGUARD_API_KEY=
